{
  "brightness": 80,
  "pages": [
    {
      "name": "Apps",
      "keys": [
        { "label": "Term", "sub": "kitty", "bg": "#1e3a5f", "action": { "type": "app", "desktopId": "kitty-zellij.desktop" } },
        { "label": "Firefox", "bg": "#7a2e0e", "action": { "type": "command", "command": "firefox" } },
        { "label": "Chrome", "bg": "#1f5130", "action": { "type": "command", "command": "google-chrome" } },
        { "label": "Code", "bg": "#0b4a7a", "action": { "type": "command", "command": "code" } },
        { "label": "Slack", "bg": "#4a154b", "action": { "type": "command", "command": "slack" } },
        { "label": "Files", "bg": "#3d3d3d", "action": { "type": "command", "command": "nautilus --new-window" } },
        { "label": "Shot", "sub": "flameshot", "bg": "#5c3d00", "action": { "type": "command", "command": "flameshot gui" } },
        {
          "label": "Mic",
          "bg": "#1f5130",
          "action": { "type": "command", "command": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle" },
          "state": "wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED",
          "on": { "label": "Mic", "sub": "MUTED", "bg": "#a01010" }
        },
        { "label": "Lock", "bg": "#222222", "action": { "type": "command", "command": "loginctl lock-session" } }
      ]
    },
    {
      "name": "Media",
      "keys": [
        { "label": "Prev", "bg": "#2b2b4a", "action": { "type": "keys", "codes": [165] } },
        { "label": "Play", "sub": "pause", "bg": "#2b4a2b", "action": { "type": "keys", "codes": [164] } },
        { "label": "Next", "bg": "#2b2b4a", "action": { "type": "keys", "codes": [163] } },
        { "label": "Vol -", "bg": "#3d3d3d", "action": { "type": "keys", "codes": [114] } },
        {
          "label": "Mute",
          "bg": "#3d3d3d",
          "action": { "type": "keys", "codes": [113] },
          "state": "wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED",
          "on": { "label": "Mute", "sub": "MUTED", "bg": "#a01010" }
        },
        { "label": "Vol +", "bg": "#3d3d3d", "action": { "type": "keys", "codes": [115] } },
        { "label": "Dim", "sub": "keypad", "bg": "#222222", "action": { "type": "builtin", "name": "brightness-down" } },
        { "label": "Super", "sub": "overview", "bg": "#222222", "action": { "type": "keys", "codes": [125] } },
        { "label": "Bright", "sub": "keypad", "bg": "#222222", "action": { "type": "builtin", "name": "brightness-up" } }
      ]
    },
    {
      "name": "AI",
      "keys": [
        { "label": "Whispr", "sub": "dictate", "bg": "#4a2b6a", "action": { "type": "command", "command": "dbus-send --session --type=method_call --dest=com.openwhispr.App /com/openwhispr/App com.openwhispr.App.Toggle" } },
        { "label": "Agent", "sub": "voice", "bg": "#4a2b6a", "action": { "type": "command", "command": "dbus-send --session --type=method_call --dest=com.openwhispr.App /com/openwhispr/App com.openwhispr.App.ToggleVoiceAgent" } },
        null,
        { "label": "Esc", "sub": "claude", "bg": "#7a3d1e", "action": { "type": "keys", "codes": [1] } },
        { "label": "Mode", "sub": "shift+tab", "bg": "#7a3d1e", "action": { "type": "keys", "codes": [42, 15] } },
        null,
        { "label": "Review", "sub": "prompt", "bg": "#1e4a4a", "action": { "type": "prompt", "text": "Review the uncommitted changes for bugs and suggest fixes.", "submit": false } },
        { "label": "Tests", "sub": "prompt", "bg": "#1e4a4a", "action": { "type": "prompt", "text": "Run the test suite and fix any failures.", "submit": false } },
        null
      ]
    }
  ]
}
